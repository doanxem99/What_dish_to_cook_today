JWT_SECRET = 'change-me-to-a-long-random-string'
# MONGODB_URI = mongodb://localhost:27017/what_dish_to_cook_today?directConnection=true
# Must include this site's own origin. Built Vue assets send an Origin header even when they
# come from the same host, so an unlisted origin is refused with 403.
# CORS_ORIGINS = http://localhost:3000,https://example.com
# Account promoted to admin on boot when it exists
# ADMIN_USERNAME = moonshine@gmail.com
# Where backup archives are written; default is server/backups
# BACKUP_DIR = D:/backups
# Assistant off by default; /api/ai/* answers 404 until true
# AI_ENABLED = false
# Chat provider: opencode-go (needs a key) or ollama (local)
# AI_PROVIDER = opencode-go
# OPENCODE_API_KEY =
# AI_MODEL = deepseek-v4.1-flash
# AI_BASE_URL = https://opencode.ai/inference/go/openai/v1
# Local embeddings through Ollama; bge-m3 needs a few GB of RAM
# EMBED_PROVIDER = ollama
# EMBED_MODEL = bge-m3
# OLLAMA_URL = http://localhost:11434
# Completed user turns per UTC day
# AI_DAILY_MESSAGE_LIMIT = 20
# AI_MAX_TOOL_ROUNDS = 3
# Soft monthly budget in USD; new calls answer 403 when reached
# AI_MONTHLY_BUDGET_USD = 10
# Escape hatch for a stuck maintenance flag on a running deployment
# MAINTENANCE_DISABLED = 0
# LibreTranslate-compatible service for the editor's auto-translate toggle
TRANSLATE_URL = http://localhost:5000/translate
# Only needed behind a reverse proxy that sets X-Forwarded-*
# TRUST_PROXY = 1
