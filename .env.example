# Copy to .env next to docker-compose.yml, then set a real JWT_SECRET.
# The Compose file reads this file for ${...} interpolation.

# Signs the session cookie. Required: Compose refuses to start without it, and the
# server would otherwise make a random secret at boot and lose every login on restart.
JWT_SECRET=change-me-to-a-long-random-string

# The site's own public origin must be listed. Built Vue assets carry crossorigin, so
# same-origin asset requests still send an Origin header; an unlisted origin is refused.
# Comma separated. Add the real domain when you put this behind a proxy.
CORS_ORIGINS=http://localhost:3000

# Host port for the site. The server always listens on 3000 inside the container.
# When this is not 3000, add the matching origin to CORS_ORIGINS.
SERVER_PORT=3000

# Account that boot promotes to admin when it exists. Leave empty for no promotion.
# Create it with POST /api/auth/signup, then restart the server container once.
ADMIN_USERNAME=

# Pinned by Compose to the mongo service; a value here is ignored.
MONGODB_URI=mongodb://mongo:27017/what_dish_to_cook_today

# Pinned by Compose to /app/backups on the backup-data volume; a value here is ignored.
BACKUP_DIR=/app/backups

# Pinned by Compose to the libretranslate service; a value here is ignored.
TRANSLATE_URL=http://libretranslate:5000/translate

# Shows the reserved AI metrics view; nothing calls a provider yet.
AI_ENABLED=false

# Escape hatch for a stuck maintenance flag on a running deployment.
MAINTENANCE_DISABLED=0

# Set to 1 only behind a reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=
